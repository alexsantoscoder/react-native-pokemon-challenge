{
  "expo": {
    "name": "Pokemon",
    "slug": "react-native-pokemon-challenge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "userInterfaceStyle": "dark",
      "supportsTablet": true,
      "bundleIdentifier": "com.alexsantoscoder.react-native-pokemon-challenge"
    },
    "android": {
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "userInterfaceStyle": "dark",
        "backgroundColor": "#000000",
        "foregroundImage": "./src/assets/android-icon-foreground.png",
        "backgroundImage": "./src/assets/android-icon-background.png",
        "monochromeImage": "./src/assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alexsantoscoder.reactnativepokemonchallenge"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash-icon.png",
          "backgroundColor": "#0064FF",
          "resizeMode": "contain",
          "imageWidth": 160,
          "android": {
            "image": "./src/assets/splash-icon.png",
            "backgroundColor": "#0064FF",
            "resizeMode": "contain",
            "imageWidth": 150
          }
        }
      ],
      "expo-sqlite"
    ]
  }
}
